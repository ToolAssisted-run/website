#!/bin/sh
# Regenerate nginx's trusted-proxy list from Cloudflare's published ranges,
# so $remote_addr is the visitor again (not the edge) and Discourse's rate
# limits and IP logs keep meaning something. Inert for traffic that does not
# come from those ranges. Run from cron monthly; reloads nginx on change.
set -e
OUT=/etc/nginx/conf.d/cloudflare-realip.conf
TMP=$(mktemp)
{
  echo "# generated by $0 on $(date -u +%Y-%m-%d); do not edit"
  for u in https://www.cloudflare.com/ips-v4 https://www.cloudflare.com/ips-v6; do
    curl -fsS "$u" | sed 's/^/set_real_ip_from /; s/$/;/'
    echo
  done
  echo "real_ip_header CF-Connecting-IP;"
} > "$TMP"
grep -q "^set_real_ip_from" "$TMP" || { echo "empty range list, keeping the old file" >&2; exit 1; }
if ! cmp -s "$TMP" "$OUT" 2>/dev/null; then
  install -m 644 "$TMP" "$OUT" && nginx -t && systemctl reload nginx
fi
rm -f "$TMP"
